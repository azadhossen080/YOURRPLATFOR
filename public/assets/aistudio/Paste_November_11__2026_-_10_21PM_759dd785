class _SettingsAndPrivacyScreenState extends State<SettingsAndPrivacyScreen> {
  bool _isDimmingEnabled = true;
  double _dimmingLevel = 30.0;
  bool _isLocationAllowed = true;
  String _selectedLanguage = 'বাংলা (Bangladesh)';

  void _openLanguagePicker() {
    final List<Map<String, String>> languages = [
      {'name': 'English (United States)', 'code': 'en_US', 'flag': '🇺🇸'},
      {'name': 'English (United Kingdom)', 'code': 'en_GB', 'flag': '🇬🇧'},
      {'name': 'English (Canada)', 'code': 'en_CA', 'flag': '🇨🇦'},
      {'name': 'English (Australia)', 'code': 'en_AU', 'flag': '🇦🇺'},
      {'name': 'বাংলা (Bangladesh)', 'code': 'bn_BD', 'flag': '🇧🇩'},
      {'name': 'বাংলা (ভারত / India)', 'code': 'bn_IN', 'flag': '🇮🇳'},
      {'name': 'हिन्दी (India)', 'code': 'hi_IN', 'flag': '🇮🇳'},
      {'name': 'اردو (Pakistan)', 'code': 'ur_PK', 'flag': '🇵🇰'},
      {'name': 'العربية (Saudi Arabia)', 'code': 'ar_SA', 'flag': '🇸🇦'},
      {'name': 'Español (Spain)', 'code': 'es_ES', 'flag': '🇪🇸'},
      {'name': 'Français (France)', 'code': 'fr_FR', 'flag': '🇫🇷'},
      {'name': 'Deutsch (Germany)', 'code': 'de_DE', 'flag': '🇩🇪'},
      {'name': '日本語 (Japan)', 'code': 'ja_JP', 'flag': '🇯🇵'},
      {'name': '한국어 (South Korea)', 'code': 'ko_KR', 'flag': '🇰🇷'},
    ];

    String searchQuery = '';

    showDialog(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final filteredLanguages = languages
                .where((lang) =>
                    lang['name']!
                        .toLowerCase()
                        .contains(searchQuery.toLowerCase()) ||
                    lang['code']!
                        .toLowerCase()
                        .contains(searchQuery.toLowerCase()))
                .toList();

            return AlertDialog(
              title: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('বিশ্বের সকল ভাষা / Select Language'),
                  const SizedBox(height: 10),
                  TextField(
                    decoration: InputDecoration(
                      hintText: 'Search language / ভাষা খুঁজুন...',
                      prefixIcon: const Icon(Icons.search),
                      isDense: true,
                      contentPadding: const EdgeInsets.all(10),
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(10),
                      ),
                    ),
                    onChanged: (value) {
                      setDialogState(() {
                        searchQuery = value;
                      });
                    },
                  ),
                ],
              ),
              content: SizedBox(
                width: double.maxFinite,
                height: 350,
                child: filteredLanguages.isEmpty
                    ? const Center(child: Text('কোনো ভাষা পাওয়া যায়নি!'))
                    : ListView.builder(
                        shrinkWrap: true,
                        itemCount: filteredLanguages.length,
                        itemBuilder: (context, index) {
                          final lang = filteredLanguages[index];
                          return ListTile(
                            leading: Text(lang['flag']!,
                                style: const TextStyle(fontSize: 22)),
                            title: Text(lang['name']!),
                            subtitle: Text('Code: ${lang['code']}'),
                            trailing: _selectedLanguage == lang['name']
                                ? const Icon(Icons.check_circle,
                                    color: Color(0xFF5352ED))
                                : null,
                            onTap: () {
                              setState(() {
                                _selectedLanguage = lang['name']!;
                              });
                              Navigator.pop(context);
                              ScaffoldMessenger.of(context).showSnackBar(
                                SnackBar(
                                    content: Text(
                                        'ভাষা নির্ধারণ করা হয়েছে: ${lang['name']}')),
                              );
                            },
                          );
                        },
                      ),
              ),
            );
          },
        );
      },
    );
  }

