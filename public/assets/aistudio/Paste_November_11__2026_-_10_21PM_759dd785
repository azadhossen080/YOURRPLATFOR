          ListTile(
            leading: const Icon(Icons.article_outlined),
            title: const Text('ম্যানেজ পোস্ট (Manage Posts)'),
            subtitle: const Text('প্রকাশিত পোস্ট ডিলিট বা এডিট করতে ট্যাপ করুন'),
            trailing: const Icon(Icons.arrow_forward_ios, size: 16),
            onTap: _openManagePostsDialog,
          ),
          SwitchListTile(
            secondary: const Icon(Icons.brightness_medium),
            title: const Text('কন্টেন্ট প্রিপারেশন ও ডিমিং সিস্টেম'),
            subtitle: Text('ডিমিং পারসেন্টেজ: ${_dimmingLevel.toInt()}%'),
            value: _isDimmingEnabled,
            onChanged: (val) => setState(() => _isDimmingEnabled = val),
          ),
          if (_isDimmingEnabled)
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16),
              child: Slider(
                value: _dimmingLevel,
                min: 0,
                max: 100,
                activeColor: const Color(0xFF5352ED),
                onChanged: (val) => setState(() => _dimmingLevel = val),
              ),
            ),
          const Divider(),

          const ListTile(
            title: Text('প্রাইভেসি ও সিকিউরিটি',
                style: TextStyle(fontWeight: FontWeight.bold, color: Color(0xFF5352ED))),
          ),
          SwitchListTile(
            secondary: const Icon(Icons.location_on_outlined),
            title: const Text('লোকেশন পারমিশন (Location Services)'),
            subtitle: const Text('পোস্টে লোকেশন তথ্য শেয়ারিং অপশন'),
            value: _isLocationAllowed,
            onChanged: (val) => setState(() => _isLocationAllowed = val),
          ),
        ],
      ),
    );
  }
